// Cloudflare deploy of robotmsgs.com: a static-assets Worker serving dist/
// (built by `pnpm run build`; no server code). `pnpm run deploy` builds, runs the tests, then uploads.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "robotmsgs",
  // Not a secret (Cloudflare docs): lets CI deploy with only CLOUDFLARE_API_TOKEN.
  "account_id": "c2747ee6a8842e150e38acc3d044adde",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // WHY workers_dev on: robotmsgs.<account>.workers.dev keeps working even if the custom domain breaks.
  "workers_dev": true,
  // robotmsgs.com must be a zone on this Cloudflare account; wrangler then attaches the domains and certificates itself.
  "routes": [
    { "pattern": "robotmsgs.com", "custom_domain": true },
    { "pattern": "www.robotmsgs.com", "custom_domain": true }
  ]
}
